# The actual config file is never tracked in git.

CLOUD_SYNC_ENABLED="false"
GITHUB_USER=""
GITHUB_TOKEN=""
VAULT_REPO="vltimate-cv-vault"
LLM_PROVIDER="agy"
LLM_MODEL=""
CLOUD_STUDIO_URL=""
USE_SIMPLE_GLYPHS=""
